{
  "_doc": "Hand ports of Fig Generators whose postProcess was JavaScript (ADR 0003). Per spec file: match a Generator by its exact `script` (or `custom: true` for script-less ones), then replace its fields with `set`. Applied by port-generators.mjs.",
  "git": [
    { "script": ["git", "--no-optional-locks", "branch", "--no-color", "--sort=-committerdate"],
      "set": { "parse": { "pattern": "^[*+ ] (?P<name>\\S+)", "exclude": "HEAD", "description": "Branch" } } },
    { "script": ["git", "--no-optional-locks", "branch", "-a", "--no-color", "--sort=-committerdate"],
      "set": { "parse": { "pattern": "^[*+ ] (?:remotes/[^/ ]+/)?(?P<name>\\S+)", "exclude": "HEAD", "description": "Branch" } } },
    { "script": ["git", "--no-optional-locks", "log", "--oneline"],
      "set": { "script": ["git", "--no-optional-locks", "log", "--oneline", "--max-count=200"],
               "parse": { "pattern": "^(?P<name>\\S+) (?P<description>.*)$" } } },
    { "script": ["git", "rev-list", "--all", "--oneline"],
      "set": { "script": ["git", "rev-list", "--all", "--oneline", "--max-count=200"],
               "parse": { "pattern": "^(?P<name>\\S+) (?P<description>.*)$" } } },
    { "script": ["git", "--no-optional-locks", "config", "--get-regexp", "^alias."],
      "set": { "parse": { "pattern": "^alias\\.(?P<name>\\S+) (?P<description>.*)$" } } },
    { "script": ["git", "config", "--get-regexp", ".*"],
      "set": { "parse": { "pattern": "^(?P<name>\\S+) (?P<description>.*)$" } } },
    { "script": ["git", "--no-optional-locks", "stash", "list"],
      "set": { "parse": { "pattern": "^(?P<name>stash@\\{\\d+\\}): (?P<description>.*)$" } } },
    { "script": ["git", "--no-optional-locks", "diff", "--cached", "--name-only"],
      "set": { "parse": { "description": "Staged file" } } },
    { "script": ["git", "--no-optional-locks", "remote", "-v"],
      "set": { "parse": { "pattern": "^(?P<name>\\S+)\\s+(?P<description>\\S+)" } } },
    { "script": ["git", "--no-optional-locks", "tag", "--list", "--sort=-committerdate"],
      "set": { "parse": { "description": "Tag" } } },
    { "script": ["git", "--no-optional-locks", "status", "--short"],
      "set": { "parse": { "pattern": "^(?P<description>..) \"?(?P<name>.+?)\"?$" } } }
  ],
  "docker": [
    { "script": ["docker", "ps", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Names", "description": "Image" } } } },
    { "script": ["docker", "ps", "-a", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Names", "description": "Image" } } } },
    { "script": ["docker", "ps", "--filter", "status=paused", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Names", "description": "Image" } } } },
    { "script": ["docker", "image", "ls", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Repository", "description": "Tag" } } } },
    { "script": ["docker", "images", "-a", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "ID", "description": "Repository" } } } },
    { "script": ["docker", "images", "--format", "{{.Repository}} {{.Size}} {{.Tag}} {{.ID}}"],
      "set": { "parse": { "pattern": "^(?P<name>\\S+) (?P<description>.*)$" } } },
    { "script": ["docker", "context", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "Description" } } } },
    { "script": ["docker", "node", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "ID", "description": "Hostname" } } } },
    { "script": ["docker", "network", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "ID" } } } },
    { "script": ["docker", "plugin", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "ID" } } } },
    { "script": ["docker", "secret", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "ID" } } } },
    { "script": ["docker", "service", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "Image" } } } },
    { "script": ["docker", "stack", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "ID" } } } },
    { "script": ["docker", "volume", "list", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "Driver" } } } },
    { "script": ["docker", "volume", "ls", "--format", "{{ json . }}"],
      "set": { "parse": { "json": { "name": "Name", "description": "Driver" } } } }
  ],
  "brew": [
    { "script": ["brew", "list", "-1"], "set": { "parse": { "exclude": "=", "description": "Installed formula" } } },
    { "script": ["brew", "list", "-1", "--cask"], "set": { "parse": { "description": "Installed cask" } } },
    { "script": ["brew", "outdated", "-q"], "set": { "parse": { "description": "Outdated" } } },
    { "script": ["brew", "tap"], "set": { "parse": { "description": "Tap" } } },
    { "script": ["brew", "formulae"], "set": { "cache": { "ttl": 3600000 }, "scriptTimeout": 15000, "parse": { "description": "Formula" } } },
    { "script": ["brew", "casks"], "set": { "cache": { "ttl": 3600000 }, "scriptTimeout": 15000, "parse": { "description": "Cask" } } },
    { "script": ["bash", "-c", "brew services list | sed -e 's/ .*//' | tail -n +2"], "set": { "parse": { "description": "Service" } } },
    { "script": ["bash", "-c", "find ~/.brew-aliases/ -type f ! -name \"*.*\" -d 1 | sed \"s/.*\\///\""], "set": { "parse": { "description": "Alias" } } }
  ],
  "npm": [
    { "script": ["bash", "-c", "until [[ -f package.json ]] || [[ $PWD = '/' ]]; do cd ..; done; cat package.json"],
      "set": { "parse": { "json": { "path": "scripts", "name": "$key", "description": "$value" } } } }
  ],
  "cd": [
    { "custom": true, "set": { "template": "folders" } }
  ]
}
